PORT=3001

# Origenes permitidos por CORS (produccion): dominio publico del frontend en
# Vercel, separados por coma si hay mas de uno. Si se omite, el servidor
# acepta cualquier origen (vale para pruebas; en produccion se avisa en el log).
CORS_ORIGIN=https://tu-frontend.vercel.app

# Servidor MySQL externo (Railway, PlanetScale, Aiven... o local).
# Cada variable acepta ademas el alias que inyectan algunos proveedores
# (plugin de Railway: MYSQLHOST, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE,
# MYSQLPORT); sin nada definido el servidor usa los defaults locales
# localhost / root / '' / statlab_db / 3306.
DB_HOST=localhost
DB_USER=statlab
DB_PASSWORD=cambia-esta-clave
DB_NAME=statlab_db
DB_PORT=3306
# Conexiones simultaneas del pool (opcional, por defecto 10)
DB_POOL=10

JWT_SECRET=cambia-este-secreto-en-produccion

# Correo SMTP para la recuperacion de contrasena (Nodemailer).
# Sin correo configurado los codigos se imprimen en la consola del servidor
# (solo vale para desarrollo).
#
# Gmail (recomendado para pruebas):
#   1. Activa la verificacion en dos pasos de la cuenta Google.
#   2. Genera una CONTRASENA DE APLICACION de 16 caracteres en
#      https://myaccount.google.com/apppasswords  (NO sirve la contrasena
#      personal: Google la rechaza con EAUTH).
#   3. Deja SMTP_HOST vacio (se infiere smtp.gmail.com:587) o ponlo explicito.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=abcdefghijklmnop
MAIL_FROM=StatLab <no-responder@statlab.dev>

# Alias aceptados (respaldo de SMTP_USER / SMTP_PASS si vienes de otra plantilla):
# EMAIL_USER=
# EMAIL_PASS=
